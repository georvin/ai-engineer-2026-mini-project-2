# Salin file ini menjadi .env lalu isi nilainya. File .env TIDAK di-commit.
DATABASE_URL=postgresql://user:password@host:5432/dbname
STUDENT_NAME=nama_kamu
INTERNAL_API_KEY=ganti-dengan-api-key
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_EXPIRY_MINUTES=30
CLIENT_ID=ganti-dengan-client-id
CLIENT_SECRET=ganti-dengan-client-secret
